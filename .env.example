# Copy to .env at repository root. Only the model worker receives these values.
TEAM_MODEL=openai/gpt-4.1
TEAM_API_KEY=
TEAM_BASE_URL=
TEAM_DATA_DIR=./data
TEAM_RUNNER_IMAGE=four-agent-python:1
TEAM_RUN_TIMEOUT=900
TEAM_AGENT_TIMEOUT=120
TEAM_CHECK_TIMEOUT=60
TEAM_MAX_FIXES=2
TEAM_MAX_REVIEW_FIXES=1
TEAM_MAX_ACTIVE=2
TEAM_MAX_QUEUED=20
TEAM_MAX_MODEL_CALLS=16
# Frontend server proxy target; no browser-visible API secrets.
API_URL=http://127.0.0.1:8000
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
